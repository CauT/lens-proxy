<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="io.lens.proxyprobe"
    android:versionCode="1" android:versionName="1.0">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="Lens Android Probe" android:debuggable="true" android:testOnly="true"
        android:allowBackup="false" android:usesCleartextTraffic="true">
